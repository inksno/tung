cabal-version: 3.0
name: tung
version: 0.1.0.0
synopsis: Compiler and runner for tung, a dependently typed functional language
description:
  tung is a functional language with dependent types, inductive families,
  type classes with checked laws, and actions performed by a runner. this
  package provideth the compiler, the checker, and the runner.
category: Language, Compiler
license: LGPL-3.0-or-later
license-files: COPYING, COPYING.LESSER
author: svartaz
maintainer: svartaz
homepage: https://github.com/svartaz/tung
bug-reports: https://github.com/svartaz/tung/issues
build-type: Simple

common warnings
  ghc-options: -j -Wall -Wno-name-shadowing -Wno-unused-do-bind
  default-extensions:
      BlockArguments
    , DerivingStrategies
    , GeneralizedNewtypeDeriving
    , LambdaCase
    , ImportQualifiedPost
    , NamedFieldPuns
    , RecordWildCards
    , TupleSections

library
  import: warnings
  exposed-modules: Tung, Tung.Core, Tung.Run, Tung.Source
  other-modules:
      Tung.Concrete
    , Tung.Core.Check
    , Tung.Core.Host
    , Tung.Core.Inductive
    , Tung.Core.Literal
    , Tung.Core.Normalise
    , Tung.Core.Render
    , Tung.Core.Syntax
    , Tung.Core.Universe
    , Tung.Diagnostic
    , Tung.Editor
    , Tung.Format
    , Tung.Format.Layout
    , Tung.Format.Shorten
    , Tung.Highlight
    , Tung.Identity
    , Tung.Library
    , Tung.Metadata
    , Tung.Name
    , Tung.Primitive
    , Tung.Project
    , Tung.Source.Cache
    , Tung.Source.Declaration
    , Tung.Source.Elaborate
    , Tung.Source.Environment
    , Tung.Source.Error
    , Tung.Source.Expression
    , Tung.Source.Instance
    , Tung.Source.Module
    , Tung.Source.Parse
    , Tung.Source.Pattern
    , Tung.Source.Pattern.Common
    , Tung.Source.Pattern.Index
    , Tung.Source.Pattern.Match
    , Tung.Source.Proof
    , Tung.Source.Render
    , Tung.Source.Scope
    , Tung.Source.Syntax
    , Tung.Source.Unify
    , Tung.Token
    , Tung.Web
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
      aeson >=2 && <3
    , base >=4.20 && <5
    , binary
    , bytestring
    , containers
    , deepseq
    , directory
    , filepath
    , megaparsec
    , network >=3.1 && <4
    , process
    , stm
    -- text 2 compareth utf-8 bytes, which is code-point order; library's
    -- string order model assumeth it.
    , text >=2 && <3
    , time
    , transformers
    , yaml >=0.11 && <0.12

executable tung
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  build-depends:
      base >=4.20 && <5
    , containers
    , directory
    , filepath
    , tung

benchmark tung-benchmark
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: benchmark
  ghc-options: -rtsopts -with-rtsopts=-T
  default-language: Haskell2010
  build-depends:
      base >=4.20 && <5
    , containers
    , directory
    , filepath
    , process
    , tung

test-suite tung-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options: -threaded
  default-extensions: MultilineStrings
  other-modules:
      Test.Class
    , Test.Compile
    , Test.Core
    , Test.CoreInductive
    , Test.Diagnostic
    , Test.Effect
    , Test.Evaluate
    , Test.Field
    , Test.Format
    , Test.Harness
    , Test.HarnessTests
    , Test.Host
    , Test.Inductive
    , Test.Integration
    , Test.Layering
    , Test.Library
    , Test.List
    , Test.Literal
    , Test.Match
    , Test.Module
    , Test.Name
    , Test.Parse
    , Test.Program
    , Test.Project
    , Test.Recursion
    , Test.Source
    , Test.Standard
    , Test.Support
    , Test.Token
    , Test.Type
    , Test.Validate
  default-language: Haskell2010
  build-depends:
      aeson >=2 && <3
    , base >=4.21 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , network >=3.1 && <4
    , process
    , QuickCheck
    , text
    , time
    , transformers
    , tung

source-repository head
  type: git
  location: https://github.com/svartaz/tung.git
  subdir: tongue
